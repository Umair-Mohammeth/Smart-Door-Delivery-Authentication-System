// -- WiFi & Telegram Credentials --
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
#define BOT_TOKEN "YOUR_TELEGRAM_BOT_TOKEN"
#define CHAT_ID "YOUR_CHAT_ID"

// -- Hardware Pin Definitions --
// AI-Thinker ESP32-CAM (Fixed Pin Mapping)
// Note: We use LittleFS instead of SD_MMC to free up GPIOs for sensors.

#define PWDN_GPIO_NUM     32
#define RESET_GPIO_NUM    -1
#define XCLK_GPIO_NUM      0
#define SIOD_GPIO_NUM     26
#define SIOC_GPIO_NUM     27
#define Y9_GPIO_NUM       35
#define Y8_GPIO_NUM       34
#define Y7_GPIO_NUM       39
#define Y6_GPIO_NUM       36
#define Y5_GPIO_NUM       21
#define Y4_GPIO_NUM       19
#define Y3_GPIO_NUM       18
#define Y2_GPIO_NUM        5
#define VSYNC_GPIO_NUM    25
#define HREF_GPIO_NUM     23
#define PCLK_GPIO_NUM     22

// RFID Reader (MFRC522)
// SPI Pins (Standard for ESP32-CAM when SD is disabled)
#define SS_PIN    13
#define RST_PIN   -1 // Tie to 3.3V
#define SCK_PIN   14
#define MISO_PIN  2
#define MOSI_PIN  15

// HX711 Load Cell
#define HX711_DOUT_PIN 12
#define HX711_SCK_PIN  33 // Red LED pin

// Servo Motor
#define SERVO_PIN 1 // U0TXD (Requires disconnecting Serial for operation, or use 14/15/13/2 if RFID is not used)
// Alternative: If RFID is required, use Pin 4 (Flash LED) for Servo if pulse interference is acceptable.
// We will stick to Pin 4 for now to keep Serial debugging available.
#define SERVO_PIN_ALT 4

// Tamper Sensor
#define TAMPER_PIN 3 // U0RXD (Requires disconnecting Serial for operation)

// -- System Parameters --
const unsigned long executionInterval = 1000;
const unsigned long doorUnlockDuration = 5000;
const unsigned long tamperAlertInterval = 10000;

// -- Sensor & Actuator Settings --
const int SERVO_LOCKED_POS = 0;
const int SERVO_UNLOCKED_POS = 90;
#define PARCEL_DETECTION_THRESHOLD 1000
#define HX711_CALIBRATION_FACTOR 1.0

// -- RFID Configuration --
#define UID_LENGTH 4
#define UID_FILE "/uids.txt"
